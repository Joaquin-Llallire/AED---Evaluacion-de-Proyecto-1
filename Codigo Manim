from manim import *


class HashTransactions(Scene):
    def clean_scene(self, run_time=0.5):
        objects = list(self.mobjects)

        if objects:
            self.play(
                *[
                    FadeOut(obj)
                    for obj in objects
                ],
                run_time=run_time
            )

        self.clear()

    def transaction_row(
        self,
        tx_id,
        user,
        amount,
        width=8.2,
        height=0.68
    ):
        box = RoundedRectangle(
            width=width,
            height=height,
            corner_radius=0.08,
            stroke_color="#33445F",
            stroke_width=1.5,
            fill_color="#111C30",
            fill_opacity=1
        )

        tx = Text(
            tx_id,
            font_size=20,
            color="#59D8E6"
        )

        usr = Text(
            user,
            font_size=20,
            color="#91A4C0"
        )

        amt = Text(
            amount,
            font_size=20,
            color="#EAF2FF"
        )

        tx.move_to(
            box.get_center()
            + LEFT * (width * 0.32)
        )

        usr.move_to(
            box.get_center()
        )

        amt.move_to(
            box.get_center()
            + RIGHT * (width * 0.30)
        )

        return VGroup(
            box,
            tx,
            usr,
            amt
        )

    def make_bucket_table(
        self,
        count=8,
        width=4.8,
        height=0.50,
        scale=1.0
    ):
        rows = VGroup()
        cells = []

        for i in range(count):

            index = Text(
                str(i),
                font_size=20,
                color="#91A4C0"
            )

            cell = RoundedRectangle(
                width=width,
                height=height,
                corner_radius=0.06,
                stroke_color="#415574",
                stroke_width=1.4,
                fill_color="#111C30",
                fill_opacity=1
            )

            row = VGroup(
                index,
                cell
            ).arrange(
                RIGHT,
                buff=0.20
            )

            rows.add(row)
            cells.append(cell)

        rows.arrange(
            DOWN,
            buff=0.07
        )

        rows.scale(scale)

        return rows, cells

