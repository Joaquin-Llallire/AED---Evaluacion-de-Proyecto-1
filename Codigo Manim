            stroke_width=2,
            fill_color="#111C30",
            fill_opacity=1
        )

        title = Text(
            user,
            font_size=27,
            color="#59D8E6"
        )

        values = VGroup(
            Text(
                f"Operaciones recientes: {operations}",
                font_size=20,
                color="#EAF2FF"
            ),
            Text(
                f"Monto reciente: S/{total}",
                font_size=20,
                color="#EAF2FF"
            ),
            Text(
                f"Cuentas nuevas: {new_accounts}",
                font_size=20,
                color="#EAF2FF"
            )
        ).arrange(
            DOWN,
            aligned_edge=LEFT,
            buff=0.22
